# COPY this file to .env.local in the project root. .env.example is not loaded.
# Local demo: only APP_ORIGIN and NEXT_PUBLIC_MAP_PROVIDER need values.
# Real SMS links require a public HTTPS origin; a patient's phone cannot use your localhost.
APP_ORIGIN=http://localhost:3000

# SERVER-ONLY: generate a strong shared secret (openssl rand -hex 32).
# Your trusted dispatcher sends it as Authorization: Bearer <secret>.
DISPATCHER_API_KEY=

# SERVER-ONLY: YOUR durable dispatch gateway, not an OpenStreetMap endpoint.
# Gateway implements the contracts in README; obtain its URL/key from its operator.
DISPATCH_GATEWAY_URL=
DISPATCH_GATEWAY_KEY=

# OPTIONAL: trusted ingress must strip/overwrite this header. Leave blank locally.
# Accepted: cf-connecting-ip or x-real-ip. Enables coarse patient IP lookup at gateway.
TRUSTED_CLIENT_IP_HEADER=

# PUBLIC/BUILD-TIME: osm | custom | disabled.
# osm uses standard OSM tiles without an API token; follow OSM tile usage policy.
# Production emergency deployments should use a licensed/self-hosted service with suitable availability.
NEXT_PUBLIC_MAP_PROVIDER=osm

# CUSTOM ONLY: HTTPS 256px Web-Mercator raster XYZ URL containing {z}, {x}, {y}.
# Example: https://tiles.your-provider.ir/{z}/{x}/{y}.png
# Browser-visible! Only provider-approved public/domain-restricted tokens may appear here.
# Leave blank for osm. Do not put server secrets here.
NEXT_PUBLIC_MAP_TILE_URL=

# CUSTOM ONLY: exact attribution required by your provider/data license.
# Include all required data credits (e.g. OpenStreetMap contributors for OSM-derived tiles).
# Example: "© Your provider · © OpenStreetMap contributors"
NEXT_PUBLIC_MAP_ATTRIBUTION_TEXT=
# Example: https://www.your-provider.ir/attribution
NEXT_PUBLIC_MAP_ATTRIBUTION_URL=
