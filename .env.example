# Real patient links require HTTPS and these server-only integration settings.
APP_ORIGIN=https://emergency.example.ir
DISPATCHER_API_KEY=
DISPATCH_GATEWAY_URL=https://dispatch-gateway.example.ir/api/
DISPATCH_GATEWAY_KEY=

# Optional: configure ONLY when trusted ingress strips and overwrites this header.
# Accepted names: cf-connecting-ip, x-real-ip. Disabled by default.
TRUSTED_CLIENT_IP_HEADER=

# Production: your licensed/self-hosted Iran tile provider, HTTPS, NO private API keys.
# Public preview uses OpenStreetMap tiles; real /locate has no external tile default.
NEXT_PUBLIC_MAP_TILE_URL=
